# Variables públicas utilizadas por Supabase SSR.
# Completa estos valores en .env.local. No uses una service-role key aquí.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Solo para el endpoint de IA del asistente CRM cuando se autorice su activación.
# Mantener sin configurar durante las pruebas deterministas de Fase 4.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Activación explícita del endpoint IA. Mantener en false o sin definir durante la validación.
OPENAI_ASSISTANT_ENABLED=false
